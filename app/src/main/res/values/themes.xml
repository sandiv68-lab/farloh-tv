<resources>
    <style name="Theme.Farloh" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/text2</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/text2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="alertDialogTheme">@style/Theme.Farloh.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Farloh.Dialog</item>
    </style>

    <!-- Start-up screen: dark background + logo, no white icon plate. -->
    <style name="Theme.Farloh.Launch" parent="Theme.Farloh">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Every pop-up: compact lines, the app's font, buttons not in capitals. -->
    <style name="Theme.Farloh.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="alertDialogStyle">@style/Farloh.AlertDialog</item>
        <item name="dialogPreferredPadding">20dp</item>
        <item name="farlohDialogItemSize">14sp</item>
        <item name="android:windowTitleStyle">@style/Farloh.DialogTitle</item>
        <item name="buttonBarButtonStyle">@style/Farloh.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Farloh.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Farloh.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Farloh.DialogButton</item>
        <item name="android:textAppearanceMedium">@style/Farloh.DialogText</item>
    </style>

    <!-- In the player: the same pop-ups, see-through blue (80%) so the video shows behind, slightly bigger text. -->
    <style name="Theme.Farloh.Dialog.Player">
        <item name="android:windowBackground">@drawable/dialog_bg_player</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="farlohDialogItemSize">16sp</item>
        <item name="android:windowTitleStyle">@style/Farloh.DialogTitle.Player</item>
        <item name="android:textAppearanceMedium">@style/Farloh.DialogText.Player</item>
    </style>

    <style name="Farloh.DialogTitle.Player" parent="Farloh.DialogTitle">
        <item name="android:textAppearance">@style/Farloh.DialogTitle.Text.Player</item>
    </style>

    <style name="Farloh.DialogTitle.Text.Player" parent="Farloh.DialogTitle.Text">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Farloh.DialogText.Player" parent="Farloh.DialogText">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Farloh.AlertDialog" parent="AlertDialog.AppCompat">
        <item name="listItemLayout">@layout/dialog_item</item>
        <item name="singleChoiceItemLayout">@layout/dialog_single_choice</item>
        <item name="multiChoiceItemLayout">@layout/dialog_multi_choice</item>
    </style>

    <style name="Farloh.DialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/Farloh.DialogTitle.Text</item>
    </style>

    <style name="Farloh.DialogTitle.Text" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Farloh.DialogText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Farloh.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="Theme.Farloh.Player" parent="Theme.Farloh">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="alertDialogTheme">@style/Theme.Farloh.Dialog.Player</item>
        <item name="android:alertDialogTheme">@style/Theme.Farloh.Dialog.Player</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text2</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#1A1206</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="IconBtnBox">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:tint">@color/text</item>
    </style>

    <style name="IconBtn">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:tint">@color/text</item>
    </style>
</resources>
