<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <!-- Windows are added here by MultiviewActivity. -->
    <FrameLayout android:id="@+id/mvStage" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" />
    <TextView android:id="@+id/mvHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="16dp" android:background="@drawable/panel_bg"
        android:gravity="center" android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp"
        android:paddingBottom="10dp" android:textColor="@color/text" android:textSize="14sp" android:visibility="gone" />
</FrameLayout>
