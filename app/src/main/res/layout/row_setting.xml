<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"
    android:background="@drawable/focus_bg" android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:minHeight="58dp" android:orientation="horizontal"
    android:paddingStart="18dp" android:paddingTop="8dp" android:paddingEnd="18dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="16sp" />
        <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/text2" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:gravity="end" android:maxWidth="260dp" android:textColor="@color/accent"
        android:textSize="15sp" />
</LinearLayout>
