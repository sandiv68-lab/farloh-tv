<?xml version="1.0" encoding="utf-8"?>
<!-- A tick box in a pop-up list. -->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/text1"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/dialog_row_bg" android:checkMark="?android:attr/listChoiceIndicatorMultiple"
    android:checkMarkTint="@color/accent" android:ellipsize="end" android:fontFamily="sans-serif"
