<?xml version="1.0" encoding="utf-8"?>
<!-- One programme in the Live TV guide strip (player). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="210dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp"
    android:background="@drawable/focus_bg" android:clickable="true" android:focusable="true"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp"
    android:paddingBottom="8dp">
    <TextView android:id="@+id/gTime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:singleLine="true" android:textColor="@color/accent2" android:textSize="12sp" />
    <TextView android:id="@+id/gTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:ellipsize="end" android:singleLine="true" android:textColor="@color/text"
        android:textSize="14sp" />
</LinearLayout>
