<?xml version="1.0" encoding="utf-8"?>
<!--
  The player's bottom bar (same for Live TV, movies and episodes, on TV and phones):
  Channel · Speed · Audio track · Audio sync · CC · Screen size · Multiview · Star · External player · Settings.
  The name of the focused button is shown above the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/actLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:minHeight="18dp" android:textColor="@color/accent2" android:textSize="13sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="4dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/actChannels" style="@style/IconBtnBox" android:src="@drawable/ic_channels"
                android:contentDescription="Channels" />
            <Button android:id="@+id/actSpeed" style="@style/Btn" android:layout_height="44dp" android:layout_marginStart="8dp"
                android:minWidth="60dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="1.0x"
                android:textSize="14sp" android:contentDescription="Playback speed" />
            <ImageButton android:id="@+id/actAudio" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_audio" android:contentDescription="Audio track" />
            <ImageButton android:id="@+id/actSync" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_sync" android:contentDescription="Audio sync" />
            <ImageButton android:id="@+id/actCC" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_cc" android:contentDescription="Subtitles on / off (hold for more)" />
            <ImageButton android:id="@+id/actSize" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_aspect" android:contentDescription="Screen size (hold to choose)" />
            <ImageButton android:id="@+id/actMultiview" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_multiview" android:contentDescription="Multiview" />
            <ImageButton android:id="@+id/actFav" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_star_border" android:contentDescription="Favourite" />
            <ImageButton android:id="@+id/actExternal" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_external" android:contentDescription="Open in MX Player / VLC" />
            <ImageButton android:id="@+id/actSettings" style="@style/IconBtnBox" android:layout_marginStart="8dp"
                android:src="@drawable/ic_settings" android:contentDescription="Settings" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
