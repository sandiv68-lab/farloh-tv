<?xml version="1.0" encoding="utf-8"?>
<!--
  The player's bottom bar (same for Live TV, movies and episodes, on TV and phones):
  Channels · Speed · Audio track · Audio sync · CC · Screen size · Multiview · Star · Open in external · Settings.
  Spread across the full width with equal gaps (the gaps are the "actGap" views; hidden buttons take theirs with them).
  The name of the focused button is shown above the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/actLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:minHeight="18dp" android:textColor="@color/accent2" android:textSize="13sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:fillViewport="true" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:scrollbars="none">
        <LinearLayout android:id="@+id/actRow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/actChannels" style="@style/Btn" android:layout_height="44dp"
                android:drawableStart="@drawable/ic_channels" android:drawablePadding="8dp" android:paddingStart="12dp"
                android:paddingEnd="14dp" android:text="Channels" android:contentDescription="Channels" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button android:id="@+id/actSpeed" style="@style/Btn" android:layout_height="44dp"
                android:minWidth="60dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="1.0x"
                android:textSize="14sp" android:contentDescription="Playback speed" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actAudio" style="@style/IconBtnBox"
                android:src="@drawable/ic_audio" android:contentDescription="Audio track" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actSync" style="@style/IconBtnBox"
                android:src="@drawable/ic_sync" android:contentDescription="Audio sync" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actCC" style="@style/IconBtnBox"
                android:src="@drawable/ic_cc" android:contentDescription="Subtitles on / off (hold for more)" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actSize" style="@style/IconBtnBox"
                android:src="@drawable/ic_aspect" android:contentDescription="Screen size (hold to choose)" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actMultiview" style="@style/IconBtnBox"
                android:src="@drawable/ic_multiview" android:contentDescription="Multiview" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actFav" style="@style/IconBtnBox"
                android:src="@drawable/ic_star_border" android:contentDescription="Favourite" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/actExternal" style="@style/IconBtnBox"
                android:src="@drawable/ic_external" android:contentDescription="Open in external" />
            <View android:tag="gap" android:layout_width="8dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button android:id="@+id/actSettings" style="@style/Btn" android:layout_height="44dp"
                android:drawableStart="@drawable/ic_settings" android:drawablePadding="8dp" android:paddingStart="12dp"
                android:paddingEnd="14dp" android:text="Settings" android:contentDescription="Settings" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
