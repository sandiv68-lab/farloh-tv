<?xml version="1.0" encoding="utf-8"?>
<!--
  Movies & episodes (Media3 PlayerControlView custom layout), styled like the Live TV screen:
  ⏮ ⏪ ▶/⏸ ⏩ ⏭ in the middle; at the bottom a panel with the title, the seek bar and the button bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <View android:id="@id/exo_controls_background" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="#33000000" />

    <!-- Middle: playback controls -->
    <LinearLayout android:id="@id/exo_center_controls" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
        android:orientation="horizontal">
        <ImageButton android:id="@id/exo_prev" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp"
            android:contentDescription="Previous episode" />
        <ImageButton android:id="@id/exo_rew" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_marginStart="20dp" android:contentDescription="Back 10 seconds" />
        <ImageButton android:id="@id/exo_play_pause" style="@style/IconBtn" android:layout_width="76dp"
            android:layout_height="76dp" android:layout_marginStart="20dp" android:padding="16dp"
            android:contentDescription="Play / pause" />
        <ImageButton android:id="@id/exo_ffwd" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_marginStart="20dp" android:contentDescription="Forward 10 seconds" />
        <ImageButton android:id="@id/exo_next" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_marginStart="20dp" android:contentDescription="Next episode" />
    </LinearLayout>

    <!-- Bottom panel (like the Live TV info bar): title, seek bar, button bar -->
    <LinearLayout android:id="@+id/vodPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="@drawable/bottom_scrim" android:orientation="vertical"
        android:paddingStart="28dp" android:paddingTop="56dp" android:paddingEnd="28dp" android:paddingBottom="24dp">

        <TextView android:id="@+id/vodPanelTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="56dp" android:textColor="@color/text" android:textSize="14sp" />
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="0dp"
                android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" android:focusable="true"
                app:buffered_color="#66FFFFFF" app:played_color="@color/accent" app:scrubber_color="@color/accent"
                app:unplayed_color="#33FFFFFF" />
            <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="end" android:minWidth="56dp" android:textColor="@color/text" android:textSize="14sp" />
        </LinearLayout>

        <include android:id="@+id/vodActions" layout="@layout/player_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp" />
    </LinearLayout>
</FrameLayout>
