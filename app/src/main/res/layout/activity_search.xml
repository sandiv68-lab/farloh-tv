<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.3"
        android:scaleType="centerCrop" android:src="@drawable/farloh_bg" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#B3070B1A" />

    <LinearLayout android:id="@+id/safe" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp">

        <!-- Search box -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/back" style="@style/IconBtn" android:src="@drawable/ic_back"
                android:contentDescription="Back" />
            <EditText android:id="@+id/query" style="@style/Field" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp" android:hint="Type a channel, movie or show name"
                android:imeOptions="actionSearch|flagNoExtractUi" android:inputType="text"
                android:paddingTop="10dp" android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- Where to search -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp"
                android:text="Search in:" android:textColor="@color/text2" android:textSize="14sp" />
            <Button android:id="@+id/inLive" style="@style/Btn" android:drawableStart="@drawable/ic_live"
                android:drawablePadding="8dp" android:text="Live TV" />
            <Button android:id="@+id/inMovies" style="@style/Btn" android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_movie" android:drawablePadding="8dp" android:text="Movies" />
            <Button android:id="@+id/inSeries" style="@style/Btn" android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_series" android:drawablePadding="8dp" android:text="TV Shows" />
            <Button android:id="@+id/inAll" style="@style/Btn.Primary" android:layout_marginStart="8dp" android:text="All" />
        </LinearLayout>

        <!-- Result tabs (after searching "All") -->
        <LinearLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/tabLive" style="@style/Tab" />
            <TextView android:id="@+id/tabMovies" style="@style/Tab" android:layout_marginStart="8dp" />
            <TextView android:id="@+id/tabSeries" style="@style/Tab" android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/text2" android:textSize="13sp" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/results" android:layout_width="match_parent"
                android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp" />
            <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:padding="24dp"
                android:text="Type what you're looking for, then choose where to search."
                android:textColor="@color/text2" android:textSize="16sp" />
            <ProgressBar android:id="@+id/loading" android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
