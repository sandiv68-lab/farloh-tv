<?xml version="1.0" encoding="utf-8"?>
<!-- One home-screen tile + its Refresh button. Width/height are set in HomeActivity to suit the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp" android:layout_height="wrap_content"
    android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:clipChildren="false"
    android:clipToPadding="false" android:gravity="center_horizontal" android:orientation="vertical">

    <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="170dp"
        android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true"
        android:gravity="center" android:orientation="vertical" android:padding="14dp">
        <ImageView android:id="@+id/icon" android:layout_width="48dp" android:layout_height="48dp"
            android:tint="@color/accent" android:importantForAccessibility="no" />
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/text" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/text" android:textSize="13sp" />
        <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:textColor="@color/text2" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/refresh" style="@style/Btn" android:minHeight="38dp" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:drawableStart="@drawable/ic_refresh" android:drawablePadding="6dp"
            android:text="Refresh" android:textSize="13sp" />
        <ProgressBar android:id="@+id/spinner" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="8dp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
