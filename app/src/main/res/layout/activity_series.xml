<?xml version="1.0" encoding="utf-8"?>
<!-- TV show page: show info on the left, seasons + episodes use the full height on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0.4" android:scaleType="centerCrop" android:src="@drawable/farloh_bg" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/side_scrim" />

    <LinearLayout android:id="@+id/safe" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp">

        <!-- Left: show info (scrolls if the description is long) -->
        <ScrollView android:id="@+id/infoPane" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="0.32" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageButton android:id="@+id/back" style="@style/IconBtn" android:src="@drawable/ic_back"
                        android:contentDescription="Back" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <ImageButton android:id="@+id/fav" style="@style/IconBtnBox"
                        android:src="@drawable/ic_star_border" android:contentDescription="Favourite" />
                </LinearLayout>
                <ImageView android:id="@+id/poster" android:layout_width="120dp" android:layout_height="180dp"
                    android:layout_marginTop="8dp" android:background="@drawable/placeholder" android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textColor="@color/text" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/text2" android:textSize="12sp" />
                <TextView android:id="@+id/plot" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.1" android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Right: seasons across the top, episodes fill the rest -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.68"
            android:layout_marginStart="16dp" android:orientation="vertical">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/seasons" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="8dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/episodes" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp" />
                <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="center" />
                <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textColor="@color/text2" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
