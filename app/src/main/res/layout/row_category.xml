<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"
    android:background="@drawable/focus_bg" android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:minHeight="46dp" android:orientation="horizontal"
    android:paddingStart="14dp" android:paddingEnd="12dp">
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:ellipsize="end" android:maxLines="2" android:textColor="@color/text" android:textSize="15sp" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textColor="@color/text2" android:textSize="12sp" />
</LinearLayout>
