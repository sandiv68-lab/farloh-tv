<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/farloh_bg" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrim" />

    <ScrollView android:id="@+id/safe" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical" android:padding="24dp">

            <ImageView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="150dp"
                android:adjustViewBounds="true" android:src="@drawable/farloh_logo" android:contentDescription="@string/app_name" />

            <LinearLayout android:id="@+id/form" android:layout_width="440dp" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical"
                android:padding="24dp">

                <TextView android:id="@+id/heading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sign in" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Enter the details from your TV provider"
                    android:textColor="@color/text2" android:textSize="14sp" />

                <EditText android:id="@+id/playlistName" style="@style/Field" android:layout_marginTop="18dp"
                    android:hint="Playlist name (optional, e.g. Home)"
                    android:imeOptions="actionNext|flagNoExtractUi" android:inputType="textCapWords" />
                <EditText android:id="@+id/server" style="@style/Field"
                    android:hint="Server URL  (e.g. http://myserver.com:8080)"
                    android:imeOptions="actionNext|flagNoExtractUi" android:inputType="textUri" android:autofillHints="url" />
                <EditText android:id="@+id/username" style="@style/Field" android:hint="Username"
                    android:imeOptions="actionNext|flagNoExtractUi" android:inputType="text|textNoSuggestions" android:autofillHints="username" />
                <EditText android:id="@+id/password" style="@style/Field" android:hint="Password"
                    android:imeOptions="actionDone|flagNoExtractUi" android:inputType="textPassword" android:autofillHints="password" />

                <CheckBox android:id="@+id/showPassword" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Show password" android:textColor="@color/text2" />

                <Button android:id="@+id/signIn" style="@style/Btn.Primary" android:layout_width="match_parent"
                    android:layout_marginTop="12dp" android:minHeight="52dp" android:text="Sign in" android:textSize="17sp" />

                <Button android:id="@+id/cancel" style="@style/Btn" android:layout_width="match_parent"
                    android:layout_marginTop="10dp" android:text="Cancel" android:visibility="gone" />

                <ProgressBar android:id="@+id/progress" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
                <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="@color/danger" android:textSize="14sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
