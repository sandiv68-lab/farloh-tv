<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.3"
        android:scaleType="centerCrop" android:src="@drawable/farloh_bg" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#B3070B1A" />

    <LinearLayout android:id="@+id/safe" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/back" style="@style/IconBtn" android:src="@drawable/ic_back"
                android:contentDescription="Back" />
            <TextView android:id="@+id/screenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="Settings" android:textColor="@color/text"
                android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>
</FrameLayout>
