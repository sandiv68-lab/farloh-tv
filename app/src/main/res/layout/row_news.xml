<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"
    android:background="@drawable/focus_bg" android:clickable="true" android:focusable="true"
    android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <View android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginEnd="8dp" android:background="@drawable/badge_red" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:textColor="@color/text2" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.15" android:textColor="@color/text2"
        android:textSize="14sp" />
    <TextView android:id="@+id/link" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/accent2" android:textSize="13sp" />
</LinearLayout>
