<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: transparent logo on the app's dark background (no white plate). -->
    <style name="Theme.Farloh.Launch" parent="Theme.Farloh">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/bg_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/bg_deep</item>
    </style>
</resources>
