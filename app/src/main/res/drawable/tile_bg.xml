<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="18dp" /><gradient android:angle="315" android:startColor="#80FF9F43" android:endColor="#804FC3F7" /><stroke android:width="4dp" android:color="@color/accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="18dp" /><solid android:color="#55FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="18dp" /><gradient android:angle="315" android:startColor="#CC101A3A" android:endColor="#CC0A1128" /><stroke android:width="1dp" android:color="#33FFFFFF" /></shape>
    </item>
</selector>
