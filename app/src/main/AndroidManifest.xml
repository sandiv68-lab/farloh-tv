<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates: lets Farloh TV open the installer for a newer Farloh TV APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for saving/finding backups in Download/ on older devices that have no file picker. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Android 11+: lets the built-in file browser find backups / VPN files anywhere (asked for, never required). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 13+: notifications for new versions and messages. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Works on Android TV / Fire TV (remote) as well as phones and tablets (touch). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- Lets the app hand streams to MX Player / VLC on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <package android:name="com.mxtech.videoplayer.ad" />
        <!-- OpenVPN for Android: runs the VPN for Settings > Network > VPN -->
        <package android:name="de.blinkt.openvpn" />
        <intent>
            <action android:name="de.blinkt.openvpn.api.IOpenVPNAPIService" />
        </intent>
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="org.videolan.vlc" />
        <!-- File manager apps that can hand over a backup file (Android TV has no system picker). -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".FarlohApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Farloh">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.Farloh.Launch"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.HomeActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.DownloadsActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <!-- "Open with Farloh TV" for backup files in file managers -->
        <activity
            android:name=".ui.OpenBackupActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:label="Farloh TV">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-openvpn-profile" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.FileBrowserActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.NewsActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.SearchActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".ui.BrowseActivity" android:exported="false" android:screenOrientation="sensorLandscape" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.MovieDetailActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.SeriesDetailActivity" android:exported="false" android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.player"
            android:autoRemoveFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Farloh.Player" />
    </application>
</manifest>
